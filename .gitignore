# ---------------------------------------------------------------
# 构建产物与素材：体积大（约 4.4 GB），且属于游戏版权内容
# 本仓库只托管站点源码与数据构建脚本
# ---------------------------------------------------------------

# 前端依赖与构建输出
/web/node_modules/
/web/dist/
/dist/
/dist_new/
/dist_old/

# 图片 / Spine 模型产物（由 build/ 脚本从 NIKKE_SRC 生成）
/public/

# SQLite 数据库（由 build/build_db.py 生成，约 138 MB）
/data/

# 备份与截图（本地工作用）
/.backup-*/
/.shots/

# ---------------------------------------------------------------
# 代码与运行时
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.tsbuildinfo
.venv/
venv/

# 编辑器与系统
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# 本地临时
*.log
*.tmp
*.bak
